NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://leximind:replace_with_password@127.0.0.1:5432/leximind
CORS_ORIGINS=http://localhost:5173
DB_POOL_MAX=10
AUTH_TTL_SECONDS=604800
# Comma-separated IPs/CIDRs of trusted reverse proxies. Leave empty for direct traffic.
TRUSTED_PROXIES=
# Gmail SMTP for email verification and password reset codes.
# Use a Google App Password for SMTP_PASS.
SMTP_EMAIL=
SMTP_PASS=
# Generate locally with node -p "require('node:crypto').randomBytes(32).toString('hex')"
ACCOUNT_EMAIL_KEY=
# Optional with Gmail. Set to the frontend HTTPS /account-action page to include links.
ACCOUNT_ACTION_URL=
# Alternative account email provider. Educational notification email also uses Resend.
EMAIL_API_KEY=
EMAIL_FROM=
# Brevo HTTPS API for account OTPs, suitable for Render Free.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Optional educational notifications. Turn on after setting up provider credentials.
NOTIFICATION_DELIVERY_ENABLED=false
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional phone verification bot. Keep token and webhook secret on the backend.
# TG_BOT_API_KEY is also accepted as an alias for TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Set the HTTPS backend origin only when running scripts/register-telegram-webhook.cjs.
TELEGRAM_WEBHOOK_ORIGIN=
# Compose only. Percent-encode special characters in the URL password.
POSTGRES_PASSWORD=replace_with_password
COMPOSE_DATABASE_URL=postgresql://leximind:replace_with_password@db:5432/leximind
# Dedicated PostgreSQL test role with CREATEDB. Tests own their temporary DBs.
# Profile avatars (Cloudinary project credentials, backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TEST_DATABASE_URL=postgresql://leximind_test:test_password@127.0.0.1:5432/postgres
